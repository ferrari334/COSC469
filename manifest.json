{
  "name": "Hello Extensions",
  "description": "Base Level Extension",
  "version": "1.0",
  "manifest_version": 3,
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://api.deepinfra.com/*"
  ],
  "action": {
    "default_popup": "extension.html",
    "default_icon": "hello_extensions.png"
  }
}